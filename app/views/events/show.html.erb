<% content_for :title, "#{@event.title} · Gather" %>

<article class="event">
  <%= link_to "← All events", events_path, class: "back-link" %>

  <header class="event__header">
    <%= event_date_badge(@event) %>
    <div>
      <h1><%= @event.title %></h1>
      <p class="muted"><%= event_time(@event) %></p>
    </div>
  </header>

  <div class="event__layout">
    <div class="card event__description">
      <h2>About this event</h2>
      <%= simple_format(@event.description) %>
    </div>

    <aside class="card event__facts" id="event-facts">
      <dl>
        <dt>Where</dt>
        <dd><%= @event.venue %></dd>
        <dt>Organizer</dt>
        <dd><%= @event.organizer.name %></dd>
        <dt>Seats</dt>
        <dd>
          <% if @event.full? %>
            Full · <%= @event.waitlist_count %> waiting
          <% else %>
            Seats left: <%= @event.seats_left %> of <%= @event.capacity %>
          <% end %>
        </dd>
      </dl>
      <%= render "events/rsvp_card" %>
      <% if @event.organized_by?(Current.user) %>
        <%= link_to "Edit event", edit_event_path(@event), class: "button button--ghost" %>
      <% end %>
    </aside>
  </div>
</article>
