<li id="<%= dom_id(comment) %>" class="comment">
  <p class="comment__meta small">
    <strong><%= comment.user.name.presence || "Someone" %></strong>
    <time class="muted" datetime="<%= comment.created_at.iso8601 %>"><%= comment_time(comment) %></time>
  </p>
  <div class="comment__body"><%= simple_format(h(comment.body)) %></div>
  <%= render "comments/reactions", comment: comment, counts: reaction_counts[comment.id], current_kind: nil %>
  <% if comment.deletable_by?(Current.user) %>
    <%= button_to "Delete", event_comment_path(comment.event_id, comment), method: :delete, class: "button button--ghost",
          form: { data: { turbo_confirm: "Delete this comment?" } } %>
  <% end %>
</li>
